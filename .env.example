# Expo — copia a .env solo si necesitas forzar una URL concreta.
# Si no defines nada, la app detecta la URL según emulador / Expo Go / web.

# Emulador Android (recomendado si usas Android Studio):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Móvil físico en la misma Wi‑Fi (sustituye por la IP de tu PC: ip -4 addr):
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3000

# iOS Simulator:
# EXPO_PUBLIC_API_URL=http://localhost:3000
