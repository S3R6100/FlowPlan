{
  "name": "flowplan",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "npm run dev -w @flowplan/server",
    "server:start": "npm run start -w @flowplan/server",
    "db:push": "npm run db:push -w @flowplan/server",
    "db:seed": "npm run db:seed -w @flowplan/server",
    "engine:test": "npm run test -w @flowplan/engine",
    "setup:server": "docker compose up -d && cp -n server/.env.example server/.env && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
