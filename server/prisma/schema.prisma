generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  events       Event[]
  projects     Project[]
  goals        WeeklyGoal[]
  routines     Routine[]
  tasks        Task[]
  weekProfiles WeekProfile[]
  milestones   Milestone[]
  sessions     WorkSession[]
  missions     DailyMission[]
}

model Event {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  category  String   @default("General")
  type      String   @default("fixed")
  date      String
  startHour Float
  endHour   Float
  status    String   @default("active")
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model Project {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      String       @default("personal")
  color     String?
  goals     WeeklyGoal[]
  tasks     Task[]
  createdAt DateTime     @default(now())

  @@index([userId])
}

model WeeklyGoal {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String
  targetHours  Float
  currentHours Float         @default(0)
  color        String        @default("#6366F1")
  weekKey      String
  milestones   Milestone[]
  sessions     WorkSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, weekKey])
}

model Routine {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  completedToday  Boolean  @default(false)
  lastCompletedOn String?
  createdAt       DateTime @default(now())

  @@index([userId])
}

model Task {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String
  priority     String   @default("media")
  status       String   @default("pendiente")
  deadline     String?
  weekKey      String
  linkedGoalId String?
  spentMinutes Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, weekKey])
}

model WeekProfile {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekKey         String
  mode            String   @default("equilibrado")
  criticalTaskIds String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, weekKey])
}

model Milestone {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId      String?
  goal        WeeklyGoal? @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  bonusPoints Int         @default(40)
  completed   Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([userId])
}

model WorkSession {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String?
  goal      WeeklyGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  taskId    String?
  minutes   Float
  date      String
  createdAt DateTime    @default(now())

  @@index([userId, date])
}

model DailyMission {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  date         String
  deadlineHour Float?
  status       String   @default("pendiente")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, date])
}
